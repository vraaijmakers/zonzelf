# Copy to .env.local for development, or set these in Vercel per environment
# (Preview = staging, Production = main). Never commit real values — this
# repo is public. See CLAUDE.md, "Public repo hygiene".

# Supabase project settings → API. The anon key is safe to expose to the
# browser (RLS is the real access control) — the service-role key is not
# used anywhere in this app and should never be added here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key — powers /api/scan-label (component label OCR).
ANTHROPIC_API_KEY=
