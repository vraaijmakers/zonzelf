# Copy to .env.local for development. Staging reads its values from the
# environment on the self-hosted Docker host; there is no production host yet.
# Never commit real values — this repo is public. See CLAUDE.md, "Public repo
# hygiene".

# Supabase project settings → API. The anon key is safe to expose to the
# browser — RLS is the real access control, not secrecy. The service-role key
# is a separate variable further down, used only by scripts/ and never by the
# app; it must never be imported from src/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key — powers /api/scan-label (component label OCR).
ANTHROPIC_API_KEY=

# Scripts-only (scraper, batch jobs) — NEVER imported by src/. The Next.js
# app itself still never touches this; RLS is the app's access control (see
# above). scripts/scrape-*.ts uses this to write unpublished battery_models
# rows past RLS, which is exactly what the service-role key is for offline
# jobs. Supabase project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Affiliate link templates — one per shop, from that programme's own dashboard
# after it accepts you. Unset means "no programme yet": links to that shop
# publish clean, earn nothing, and carry no disclosure, which is the honest
# state and the state the repo ships in.
#
# The value is a TEMPLATE, not a bare code, because networks disagree on the
# shape — an in-house programme tends to append a parameter to the shop's own
# URL, a network like Awin wraps it in a redirect. Two placeholders, one of
# which must appear or the link is refused as one that would drop the reader's
# destination:
#
#   {URL}      the product URL, inserted as-is
#   {URL_ENC}  the product URL, percent-encoded for use inside a query value
#
# Shapes, for illustration — neither is a real credential:
#   NEXT_PUBLIC_AFFILIATE_SIGNATURE_SOLAR={URL}?ref=your-code
#   NEXT_PUBLIC_AFFILIATE_SUNGOLDPOWER=https://www.awin1.com/cread.php?awinmid=MID&awinaffid=AFFID&ued={URL_ENC}
#
# NEXT_PUBLIC_ on purpose: the link is built in the browser and the tag travels
# in the outbound URL anyway, so it is not a secret. It IS inlined at build
# time, so adding one needs a rebuild, not just a restart. Setting any of these
# automatically turns on the FTC disclosure next to the affected links and
# rel="sponsored" on them — see src/lib/affiliate.ts.
NEXT_PUBLIC_AFFILIATE_SIGNATURE_SOLAR=
NEXT_PUBLIC_AFFILIATE_SUNGOLDPOWER=
NEXT_PUBLIC_AFFILIATE_A1SOLARSTORE=
